# Server-side AI settings. Do not prefix these with VITE_.
AI_BASE_URL=https://onehub.cocorobo.cn/v1
AI_API_KEY=replace-with-your-server-side-key
AI_MODEL=deepseek-chat
AI_PROXY_HOST=127.0.0.1
AI_PROXY_PORT=8787
# Set to 1 when a trusted reverse proxy is the only client. Loopback proxies are trusted by default.
AI_TRUST_PROXY=1

# Optional server-side device SSH defaults. Leave unset to ask for them in the UI.
COCOPI_SSH_USER=root
# COCOPI_SSH_PASSWORD=replace-with-device-password

